# Copy this file to .env and fill in real values for your machine:
#   cp .env.example .env
# .env is gitignored and must never be committed. This file (.env.example)
# contains no real secrets - only variable names and safe placeholders - and
# is safe to commit.

# Google Maps JavaScript API key, used only by the Flask web UI
# (server.py / web/index.html) to render the map. Not required to run the
# routing engine, the evaluation pipeline, the JSON API, or the Streamlit
# UI - all of those work with this left empty.
#
# Get a key at https://console.cloud.google.com/google/maps-apis -
# restrict it (HTTP referrers for browser use, or IP addresses) to the
# origins you actually serve this app from. A Maps JavaScript API key is
# sent to and used by the browser, so it is visible to anyone who views
# the page source - the restrictions in Google Cloud Console, not secrecy,
# are what keep it safe to use client-side.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# PORT and HOST are deliberately left out of this file. They are
# deployment config, not secrets, and config.py already has working
# defaults for both the bare-metal and Docker cases (127.0.0.1 / 0.0.0.0
# respectively - see Dockerfile). Putting HOST=127.0.0.1 in a .env that
# Docker loads via --env-file/env_file would override the container's
# required 0.0.0.0 and silently break `docker run -p` - learned the hard
# way while building this, so don't re-add it here. If you really need a
# non-default PORT or HOST, set it with a real shell `export` instead:
#   export PORT=9000
